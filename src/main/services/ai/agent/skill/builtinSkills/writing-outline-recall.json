{
  "id": "writing-outline-recall",
  "name": "写作大纲召回",
  "description": "写作大纲召回——读取写作项目大纲供后续创作参考。当需要在写作中参照既有大纲结构、章节安排、人物弧光时调用。当前为占位实现（readOutline 工具将在方向 B 完整对接），用于验证写作组技能编排能力。",
  "category": "writing",
  "version": "1.0.0",
  "author": "system",
  "tags": ["写作", "大纲", "召回", "writing", "outline"],
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "description": "写作项目 ID（可选，用于定位特定项目大纲）"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "outlineResult": {
        "type": "object",
        "description": "大纲读取结果（含章节结构、人物设定等）"
      }
    }
  },
  "type": "tool-sequence",
  "implementation": {
    "steps": [
      {
        "toolName": "readOutline",
        "argsTemplate": "{}",
        "resultKey": "outlineResult",
        "optional": false
      }
    ]
  },
  "requiredTools": ["readOutline"],
  "examples": [
    {
      "input": { "projectId": "proj_001" },
      "output": {
        "outlineResult": {
          "success": true,
          "data": {
            "chapters": [
              { "title": "第一章 启程", "summary": "主角踏上旅程..." },
              { "title": "第二章 相遇", "summary": "主角遇到关键伙伴..." }
            ],
            "characters": [
              { "name": "主角", "arc": "成长型" }
            ]
          }
        }
      },
      "description": "读取项目 proj_001 的大纲结构，供写作时参照"
    }
  ],
  "createdAt": "2026-07-30T00:00:00.000Z",
  "updatedAt": "2026-07-30T00:00:00.000Z"
}
