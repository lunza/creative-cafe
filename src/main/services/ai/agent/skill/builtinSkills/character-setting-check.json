{
  "id": "character-setting-check",
  "name": "角色设定核查",
  "description": "角色设定核查——检索世界书与历史对话比对一致性。当需要验证角色当前行为是否符合其设定、或排查角色走样（OOC）时调用。组合检索世界书关键词匹配 + 历史对话语义召回，为一致性比对提供原始素材。",
  "category": "dialogue",
  "version": "1.0.0",
  "author": "system",
  "tags": ["角色", "设定", "核查", "一致性", "OOC", "dialogue"],
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "核查关键词（如角色名、设定关键词、待验证的行为描述）"
      },
      "characterId": {
        "type": "string",
        "description": "角色卡 ID（可选，用于定位特定角色设定）"
      }
    },
    "required": ["query"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "worldbookResult": {
        "type": "object",
        "description": "世界书检索结果（含 entries 数组）"
      },
      "chatHistoryResult": {
        "type": "object",
        "description": "历史对话检索结果（含 fragments 数组）"
      }
    }
  },
  "type": "tool-sequence",
  "implementation": {
    "steps": [
      {
        "toolName": "searchWorldbook",
        "argsTemplate": "{\"query\": \"{{input.query}}\"}",
        "resultKey": "worldbookResult",
        "optional": false
      },
      {
        "toolName": "searchChatHistory",
        "argsTemplate": "{\"query\": \"{{input.query}}\"}",
        "resultKey": "chatHistoryResult",
        "optional": true
      }
    ]
  },
  "requiredTools": ["searchWorldbook", "searchChatHistory"],
  "examples": [
    {
      "input": { "query": "爱丽丝的性格设定", "characterId": "char_001" },
      "output": {
        "worldbookResult": {
          "success": true,
          "data": {
            "entries": [
              {
                "name": "爱丽丝-性格",
                "content": "外表冷酷内心温柔，对陌生人保持距离感...",
                "keywords": ["爱丽丝", "性格"],
                "matchType": "primary",
                "matchScore": 1.0
              }
            ],
            "total": 1
          }
        },
        "chatHistoryResult": {
          "success": true,
          "data": {
            "fragments": [
              {
                "content": "爱丽丝对陌生人冷淡地转过身去...",
                "score": 0.85,
                "timestamp": 1780000000000
              }
            ],
            "total": 1
          }
        }
      },
      "description": "检索「爱丽丝的性格设定」相关世界书条目与历史对话片段，供一致性比对"
    }
  ],
  "createdAt": "2026-07-30T00:00:00.000Z",
  "updatedAt": "2026-07-30T00:00:00.000Z"
}
